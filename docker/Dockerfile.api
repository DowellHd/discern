FROM python:3.11-slim

WORKDIR /app

# System deps for OpenCV + Tesseract OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry

# Install dependencies first (layer-cache friendly)
COPY pyproject.toml poetry.lock ./
RUN POETRY_VIRTUALENVS_CREATE=false poetry install --only main --no-root

# Install the discern package itself
COPY . .
RUN POETRY_VIRTUALENVS_CREATE=false poetry install --only main

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && uvicorn discern.api.app:app --host 0.0.0.0 --port 8000"]
