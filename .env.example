DISCERN_LOG_LEVEL=INFO
DISCERN_SEED=42
DISCERN_DATABASE_URL=postgresql://discern:discern@localhost:5432/discern

# ---------------------------------------------------------------------------
# OCR backends (tried in order; first one that responds wins)
# ---------------------------------------------------------------------------

# Ollama — free local VLM, no API key required.
# Install: https://ollama.com  then: ollama pull llava:7b
# qwen2-vl:7b is more accurate for structured forms if you have 4.4 GB free.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:7b
# OLLAMA_TIMEOUT=10   # increase to 120 for CPU-only inference

# Anthropic — fallback only; incurs usage cost.
# Omit or leave blank to disable.
# ANTHROPIC_API_KEY=sk-ant-...
