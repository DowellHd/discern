# Offline demo — runs the whole stack locally with no database, no API keys and no network.
#
#   cp .env.demo .env && python main.py
#
# To go back to the real services, delete .env (or set DISCERN_OFFLINE_DEMO=false).
# This file is committed: never put real keys or database URLs in it.

# Swap every external service for a local mock (SQLite, mock engine/OCR/LLM, seeded library).
DISCERN_OFFLINE_DEMO=true

# No login: all requests use the shared demo user.
DISCERN_DEMO_MODE=true

# Never call an LLM in the demo, regardless of keys in your environment.
DISCERN_LLM_POSTPROCESS=false

# Optional: run the real local classifier (needs torch) instead of the mock engine.
# OCR and LLM stay mocked either way, so nothing leaves your machine.
# DISCERN_OFFLINE_DEMO_REAL_MODEL=true

DISCERN_SEED=42
DISCERN_LOG_LEVEL=INFO
