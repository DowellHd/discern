# Offline demo UI. Pair with the demo API:  python main.py   (from the repo root)
#
#   cp .env.demo .env.local && npm install && npm run dev
#
# Delete .env.local to go back to the production configuration. This file is committed:
# never put real keys or URLs in it.

NEXT_PUBLIC_API_URL=http://localhost:8000
# No login screen (the demo API uses a shared demo user).
NEXT_PUBLIC_DEMO_MODE=true
# Show the real app instead of the "Back Soon" page (which stays the default in production).
NEXT_PUBLIC_BACK_SOON=false
# Show the "Try a sample document" row.
NEXT_PUBLIC_OFFLINE_DEMO=true
